-- Port of examples from lean_backend/FastProofTheory/ProofSystems/Linear.lean
-- Active theorems below are in the currently checked MyPA fragment.
-- The commented declarations are the remaining Lean examples, pending more sequent rules.

def tensor_right_from_lean using LL in GENTZEN with LL : a ⊸ b ⊸ (a ⊗ b) := by
rlolli ha
rlolli hb
rtensor ha
ax ha
ax hb

def tensor_nested_from_lean using LL in GENTZEN with LL : a ⊸ b ⊸ c ⊸ (a ⊗ (b ⊗ c)) := by
rlolli ha
rlolli hb
rlolli hc
rtensor ha
ax ha
rtensor hb
ax hb
ax hc

