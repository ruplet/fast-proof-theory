-- Urzyczyn-style classical linear sequent calculus surface, using Paoli-style rule names.
-- The currently checked subset in the engine covers the tactics used below.

theorem axiom_id using CLLp : a ⊸ a := by
rlolli h
ax h

theorem tensor_right using CLLp : a ⊸ b ⊸ (a ⊗ b) := by
rlolli ha
rlolli hb
rtensor ha
ax ha
ax hb

theorem with_right using CLLp : a ⊸ (a & a) := by
rlolli h
rwith
ax h
ax h

theorem tensor_nested using CLLp : a ⊸ b ⊸ c ⊸ (a ⊗ (b ⊗ c)) := by
rlolli ha
rlolli hb
rlolli hc
rtensor ha
ax ha
rtensor hb
ax hb
ax hc

-- Classical propositional linear logic with exponentials.
-- Urzyczyn one-sided target equivalent:
--   ⊢ ?(A^bot ⊕ B^bot), !A ⊗ !B
-- MyPA currently checks the same theorem through the two-sided surface:
--   !(A & B) ⊢ !A ⊗ !B
-- The proof uses only exponential-safe duplication: `contractbang` applies S! to a !-formula.

theorem cll_bang_with_to_tensor_bang using CLLp : !(A & B) ⊸ (!A ⊗ !B) := by
rlolli h
contractbang at h as hA hB
rtensor hA
rbang
lbang at hA
lwithl at hA
ax hA
rbang
lbang at hB
lwithr at hB
ax hB

-- Intuitionistic propositional linear logic fragment.
-- Demonstrates additive branching without duplicating linear resources.

theorem ill_tensor_plus_distrib using ILLp : (A ⊗ (B ⊕ C)) ⊸ ((A ⊗ B) ⊕ (A ⊗ C)) := by
rlolli h
ltensor at h as hA hBC
lplus at hBC as hB hC
rplusl
rtensor hA
ax hA
ax hB
rplusr
rtensor hA
ax hA
ax hC
