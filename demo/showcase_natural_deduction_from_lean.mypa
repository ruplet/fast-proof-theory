-- Lean source:
-- example (h : p ∨ q) : q ∨ p :=
--   Or.elim h
--     (fun hp : p =>
--       show q ∨ p from Or.intro_right q hp)
--     (fun hq : q =>
--       show q ∨ p from Or.intro_left p hq)

theorem or_comm_from_lean using NJp : (p ∨ q) -> (q ∨ p) := by
intro h
cases at h as hp hq
right
assumption hp
left
assumption hq
