{
  "private": true,
  "workspaces": [
    "proofAssistant/extensionVSCode",
    "proofAssistant/webMonaco"
  ],
  "scripts": {
    "compile:lsp-server": "tsc -p proofAssistant/lsp_server",
    "compile:vscode": "npm --prefix proofAssistant/extensionVSCode run compile",
    "dev:monaco": "npm --prefix proofAssistant/webMonaco run dev",
    "build:monaco": "npm --prefix proofAssistant/webMonaco run build",
    "test:e2e:monaco": "playwright test -c proofAssistant/webMonaco-e2e/playwright.config.ts",
    "install:e2e:monaco": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.2"
  }
}
