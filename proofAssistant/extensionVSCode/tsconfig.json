{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "rootDir": "..",
    "outDir": "out",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "../index.js",
    "../protocol/**/*.ts",
    "../proofStateUi/types.ts",
    "../languageSupport/**/*.ts",
    "../lsp_core/**/*.ts",
    "../lsp_server/src/**/*.ts"
  ]
}
